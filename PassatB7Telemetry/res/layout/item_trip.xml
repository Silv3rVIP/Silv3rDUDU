<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:orientation="horizontal"
    android:padding="10dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp">

    <!-- Left: Date and Duration -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_trip_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026-10-25 14:30"
            android:textColor="@color/vw_white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_trip_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Duration: 24 mins"
            android:textColor="@color/vw_gray_dim"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Center: Distance and Speeds -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_trip_dist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18.4 km"
            android:textColor="@color/vw_blue_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_trip_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Avg: 46 | Max: 92"
            android:textColor="@color/vw_gray_light"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Right: Fuel used and L/100km badge -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/item_trip_consumption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6.2 L/100km"
            android:textColor="@color/vw_green"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_trip_fuel_used"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Used: 1.14 L"
            android:textColor="@color/vw_amber"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>

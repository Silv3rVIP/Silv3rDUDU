<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#070A10"
    android:padding="12dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_launcher"
            android:layout_marginEnd="12dp"
            android:contentDescription="Icon" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AMBIENT LIGHTING"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_device_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active: LEDCAR-01-2265 • Dual-Channel DMX/BLE"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Status Pill Badge -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="● CONNECTED"
            android:textColor="#4ADE80"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/badge_connected"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_scan"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="SCAN"
            android:textColor="#F1F5F9"
            android:textSize="11sp"
            android:background="@drawable/btn_action"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_devices"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="RECONNECT"
            android:textColor="#F1F5F9"
            android:textSize="11sp"
            android:background="@drawable/btn_action"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btn_power"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="POWER ON"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_power_on"
            android:paddingStart="18dp"
            android:paddingEnd="18dp" />
    </LinearLayout>

    <!-- Main Content Area: 2 Balanced Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Column: Solid Color & Brightness -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginEnd="6dp">

            <!-- Color Swatch Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/ambient_glow_bg"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="8dp">

                <View
                    android:id="@+id/view_color_preview"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="#0066FF" />

                <TextView
                    android:id="@+id/tv_color_hex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#0066FF"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_rgb_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R: 0  G: 102  B: 255"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Quick OEM Color Palette -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OEM VEHICLE PRESETS"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <Button
                    android:id="@+id/btn_p_vw"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="VW Blue"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_action"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_p_audi"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Sport Red"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_action"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_p_cyan"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Golf Cyan"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_action"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_p_passat"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Passat Gold"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_action" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_p_purple"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Violet"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_action"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_p_green"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Emerald"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_action"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_p_orange"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Amber"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_action"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_p_white"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Ice White"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_action" />
            </LinearLayout>

            <!-- RGB Sliders -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CUSTOM COLOR TUNER"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tv_r_label"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="RED: 0"
                    android:textColor="#F87171"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <SeekBar
                    android:id="@+id/seek_r"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="255"
                    android:progress="0" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tv_g_label"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="GRN: 102"
                    android:textColor="#4ADE80"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <SeekBar
                    android:id="@+id/seek_g"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="255"
                    android:progress="102" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:id="@+id/tv_b_label"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="BLU: 255"
                    android:textColor="#60A5FA"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <SeekBar
                    android:id="@+id/seek_b"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="255"
                    android:progress="255" />
            </LinearLayout>

            <!-- Brightness Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:id="@+id/tv_brightness_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BRIGHTNESS: 100%"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btn_b25"
                    android:layout_width="44dp"
                    android:layout_height="28dp"
                    android:text="25%"
                    android:textSize="10sp"
                    android:textColor="#94A3B8"
                    android:background="@drawable/btn_action"
                    android:layout_marginEnd="4dp" />
                <Button
                    android:id="@+id/btn_b50"
                    android:layout_width="44dp"
                    android:layout_height="28dp"
                    android:text="50%"
                    android:textSize="10sp"
                    android:textColor="#94A3B8"
                    android:background="@drawable/btn_action"
                    android:layout_marginEnd="4dp" />
                <Button
                    android:id="@+id/btn_b75"
                    android:layout_width="44dp"
                    android:layout_height="28dp"
                    android:text="75%"
                    android:textSize="10sp"
                    android:textColor="#94A3B8"
                    android:background="@drawable/btn_action"
                    android:layout_marginEnd="4dp" />
                <Button
                    android:id="@+id/btn_b100"
                    android:layout_width="44dp"
                    android:layout_height="28dp"
                    android:text="MAX"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_action" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_brightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="100" />
        </LinearLayout>

        <!-- Right Column: Dynamic Modes & Audio Visualizer -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginStart="6dp">

            <!-- Dynamic Effects Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DYNAMIC ARGB / DMX EFFECTS"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- Row 1 of Effects -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/btn_effect_rainbow"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="🌈 RAINBOW FLOW"
                    android:textColor="#F1F5F9"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_action"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_effect_dream"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="✨ DREAMCOLOR"
                    android:textColor="#F1F5F9"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_action" />
            </LinearLayout>

            <!-- Row 2 of Effects -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/btn_effect_meteor"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="💫 METEOR CHASE"
                    android:textColor="#F1F5F9"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_action"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_effect_stream"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="🌊 WATER STREAM"
                    android:textColor="#F1F5F9"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_action" />
            </LinearLayout>

            <!-- Row 3 of Effects -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_effect_breathe"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="💨 PULSE BREATHE"
                    android:textColor="#F1F5F9"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_action"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_effect_curtain"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="🎪 CURTAIN FLOW"
                    android:textColor="#F1F5F9"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_action" />
            </LinearLayout>

            <!-- Direction & Solid Reset Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_direction"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="DIRECTION: FORWARD ⇄"
                    android:textColor="#60A5FA"
                    android:textSize="11sp"
                    android:background="@drawable/btn_action"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_effect_off"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="SOLID COLOR MODE"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:background="@drawable/btn_action" />
            </LinearLayout>

            <!-- Effect Speed -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_speed_label"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="EFFECT SPEED: 80%"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seek_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="80" />
            </LinearLayout>

            <!-- Music Visualizer Sync Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUDIO REACTIVE VISUALIZER"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btn_music_sync"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="SYNC WITH MUSIC"
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/btn_action" />

            <TextView
                android:id="@+id/tv_music_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Synchronize ambient LED strips to ViViMusic &amp; headunit audio"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="12dp">

    <!-- Top Navigation / Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_bg"
        android:padding="10dp"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_launcher"
            android:layout_marginEnd="10dp"
            android:contentDescription="Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LED AMBIENT"
                android:textColor="@color/text_main"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_device_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Automotive BLE Ambient Controller"
                android:textColor="@color/text_sub"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Status Pill Badge -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISCONNECTED"
            android:textColor="@color/text_red"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/badge_disconnected"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btn_devices"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="DEVICES"
            android:textColor="@color/text_main"
            android:textSize="12sp"
            android:background="@drawable/btn_action"
            android:layout_marginEnd="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/btn_scan"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="SCAN"
            android:textColor="@color/text_main"
            android:textSize="12sp"
            android:background="@drawable/btn_action"
            android:layout_marginEnd="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/btn_power"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="POWER: ON"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_power_on"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </LinearLayout>

    <!-- Content 2-Column Split -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Column: Controls & Preview -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="12dp"
            android:layout_marginEnd="6dp">

            <!-- Ambient Glow Preview Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/ambient_glow_bg"
                android:padding="10dp"
                android:layout_marginBottom="10dp">

                <View
                    android:id="@+id/view_color_preview"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="#0066ff" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tv_color_hex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#0066FF (VW Blue)"
                        android:textColor="@color/text_main"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_rgb_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R: 0  |  G: 102  |  B: 255"
                        android:textColor="@color/text_sub"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Brightness Section with Quick Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:id="@+id/tv_brightness_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Brightness: 100%"
                    android:textColor="@color/text_main"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_b25"
                    android:layout_width="40dp"
                    android:layout_height="28dp"
                    android:text="25%"
                    android:textSize="10sp"
                    android:textColor="@color/text_sub"
                    android:background="@drawable/btn_action"
                    android:layout_marginEnd="4dp" />
                <Button
                    android:id="@+id/btn_b50"
                    android:layout_width="40dp"
                    android:layout_height="28dp"
                    android:text="50%"
                    android:textSize="10sp"
                    android:textColor="@color/text_sub"
                    android:background="@drawable/btn_action"
                    android:layout_marginEnd="4dp" />
                <Button
                    android:id="@+id/btn_b75"
                    android:layout_width="40dp"
                    android:layout_height="28dp"
                    android:text="75%"
                    android:textSize="10sp"
                    android:textColor="@color/text_sub"
                    android:background="@drawable/btn_action"
                    android:layout_marginEnd="4dp" />
                <Button
                    android:id="@+id/btn_b100"
                    android:layout_width="40dp"
                    android:layout_height="28dp"
                    android:text="MAX"
                    android:textSize="10sp"
                    android:textColor="@color/text_main"
                    android:background="@drawable/btn_action" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_brightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="100"
                android:layout_marginBottom="8dp" />

            <!-- Red Slider -->
            <TextView
                android:id="@+id/tv_r_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Red: 0"
                android:textColor="#ff4d4f"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/seek_r"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:progress="0"
                android:layout_marginBottom="4dp" />

            <!-- Green Slider -->
            <TextView
                android:id="@+id/tv_g_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Green: 102"
                android:textColor="#52c41a"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/seek_g"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:progress="102"
                android:layout_marginBottom="4dp" />

            <!-- Blue Slider -->
            <TextView
                android:id="@+id/tv_b_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blue: 255"
                android:textColor="#1890ff"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/seek_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:progress="255" />
        </LinearLayout>

        <!-- Right Column: OEM Presets & Music/Effects -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="12dp"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OEM CAR PRESETS"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Preset Grid Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/btn_preset_vw"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="VW Blue"
                    android:background="#0066ff"
                    android:textColor="#ffffff"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_preset_golf_r"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Golf R Cyan"
                    android:background="#00e5ff"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_preset_audi"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Audi Red"
                    android:background="#ff0033"
                    android:textColor="#ffffff"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_preset_bmw"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="BMW Amber"
                    android:background="#ff6600"
                    android:textColor="#ffffff"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Preset Grid Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/btn_preset_mercedes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Mercedes Violet"
                    android:background="#9900ff"
                    android:textColor="#ffffff"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_preset_porsche"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Porsche Yellow"
                    android:background="#ffcc00"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_preset_amg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="AMG Green"
                    android:background="#00ff66"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_preset_warm"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Passat Warm"
                    android:background="#ffe6cc"
                    android:textColor="#000000"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Preset Grid Row 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btn_preset_white"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Pure White"
                    android:background="#ffffff"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_preset_magenta"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Night Magenta"
                    android:background="#ff0077"
                    android:textColor="#ffffff"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Dynamic & Music Sync Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DYNAMIC EFFECTS &amp; MUSIC"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/btn_effect_breathe"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Smooth Breathe"
                    android:textColor="@color/text_main"
                    android:textSize="11sp"
                    android:background="@drawable/btn_action"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_effect_rainbow"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Rainbow Flow"
                    android:textColor="@color/text_main"
                    android:textSize="11sp"
                    android:background="@drawable/btn_action" />
            </LinearLayout>

            <!-- Music Beat Sync Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_music_sync"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Music Beat Sync: OFF"
                    android:textColor="@color/text_main"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_action"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tv_music_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inactive"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
